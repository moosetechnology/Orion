"
I move a new FamixJavaClass in a MooseModel
I need the following properties of the new class

-`annotationInstances`
-`types`
-`definedAnnotationTypes`
-`lowerBoundedWildcards`
-`upperBoundedWildcards`
-`concreteEntities`
-`generics`
-`isAbstract`
-`isClassSide`
-`isFinal`
-`interfaceImplementations`
-`visibility`
-`incomingImports`
-`parentPackage`
-`imports`
"
Class {
	#name : 'ORActionMoveJavaClass',
	#superclass : 'ORActionMoveJava',
	#category : 'Orion-Java-Actions',
	#package : 'Orion-Java',
	#tag : 'Actions'
}

{ #category : 'accessing' }
ORActionMoveJavaClass >> entity: anEntity [

	IllegalType check: anEntity useTrait: FamixTClass.

	super entity: anEntity
]

{ #category : 'accessing' }
ORActionMoveJavaClass >> to: container [

	IllegalType check: container useTrait:  FamixTWithClasses .

	super to: container
]
